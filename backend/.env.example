# LLM 配置（OpenAI 兼容端点：DeepSeek / 通义 / 智谱 / Moonshot 等）
# DeepSeek 示例:  BASE_URL=https://api.deepseek.com/v1  MODEL=deepseek-chat
# 通义示例:       BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  MODEL=qwen-plus
# 智谱示例:       BASE_URL=https://open.bigmodel.cn/api/paas/v4  MODEL=glm-4-plus
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat

# 联网搜索（可选，不填则搜索工具返回提示）
TAVILY_API_KEY=

# CRM 业务接口（可选，不填则 CRM 工具返回"未配置"提示）
CRM_BASE_URL=
CRM_API_TOKEN=

# 服务
BACKEND_PORT=8000
